# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Configuration (Server-Only, Test Mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
